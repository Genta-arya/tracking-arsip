rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==============================================================
    // PENGAMANAN LINK GOOGLE DRIVE C-HASIL KPU SEKADAU
    // ==============================================================
    // 1. Dokumen link Google Drive & GAS HANYA bisa dibaca jika
    //    pengguna sudah memasukkan sandi akses yang sah (request.auth != null).
    // 2. Sebelum login, Firestore server menolak akses (Permission Denied),
    //    sehingga DevTools Chrome tidak dapat mengintip URL Drive.
    // 3. Penulisan diblokir (write: if false) agar tidak bisa diubah dari browser.
    // ==============================================================
    match /app_config/drive_settings {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ==============================================================
    // DATA HASIL SINKRONISASI GOOGLE DRIVE C-HASIL TERPUSAT
    // ==============================================================
    // Dapat DIBACA oleh seluruh pengguna/publik (termasuk incognito / mode preview)
    // HANYA dapat DITULIS oleh petugas kantor yang sudah login
    // ==============================================================
    match /scanned_data/{kecamatanId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /app_config/sync_metadata {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Audit perbaikan: hanya tambahan baru, identitas dan waktu divalidasi server.
    match /correction_history/{eventId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.token.email == 'teknis.kpusekadau@gmail.com'
        && request.resource.data.keys().hasOnly(['actorUid', 'actorName', 'actorEmail', 'action', 'kecamatan', 'desa', 'tpsFolderName', 'tpsFolderId', 'fileId', 'fileName', 'fileUrl', 'before', 'after', 'createdAt'])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorEmail == request.auth.token.email
        && request.resource.data.actorName is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.action in ['CORRECT', 'REMOVE', 'RESET', 'RESTORE']
        && request.resource.data.kecamatan is string
        && request.resource.data.desa is string
        && request.resource.data.tpsFolderName is string
        && request.resource.data.tpsFolderId is string
        && request.resource.data.fileId is string
        && request.resource.data.fileName is string
        && request.resource.data.fileUrl is string
        && request.resource.data.before is map
        && request.resource.data.after is map;
      allow update, delete: if false;
    }

    // Override/Koreksi Manual Status Anomali Berkas
    match /file_overrides/{fileId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

  }
}

