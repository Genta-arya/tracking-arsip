# ==============================================================
# KONFIGURASI FIREBASE KPU SEKADAU (.env)
# ==============================================================
# Dapatkan kredensial ini dari Firebase Console (console.firebase.google.com):
# Masuk ke Project Settings -> General -> Your apps (Web App </>)
# ==============================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Email akun staf KPU di Firebase Authentication (default: petugas@kpusekadau.local)
VITE_FIREBASE_AUTH_EMAIL=petugas@kpusekadau.local

# ==============================================================
# CATATAN KEAMANAN:
# Link Google Apps Script (gasWebAppUrl) & Folder ID (rootFolderId)
# disimpan di Firestore Database:
# - Koleksi : app_config
# - Dokumen : drive_settings
# - Field   : gasWebAppUrl, rootFolderId
#
# Agar link Drive 100% AMAN dari intipan Chrome DevTools / Network!
# ==============================================================
